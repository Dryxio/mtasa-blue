<?xml version="1.0" encoding="utf-8"?>
<!--
  MTA:SA Android - Application Manifest

  Defines app permissions, components, and hardware requirements.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimum and target SDK versions -->
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- =================================================================== -->
    <!-- Permissions                                                         -->
    <!-- =================================================================== -->

    <!-- Network access for multiplayer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Storage for game data and mods -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        android:minSdkVersion="30" />

    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep device awake during gameplay -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- =================================================================== -->
    <!-- Hardware Features                                                   -->
    <!-- =================================================================== -->

    <!-- OpenGL ES 3.0 required -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Touchscreen required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- Multitouch highly recommended -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />

    <!-- Gamepad support optional -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- =================================================================== -->
    <!-- Application                                                         -->
    <!-- =================================================================== -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MTA"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!-- Main Activity -->
        <activity
            android:name=".MTAActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MTA.Fullscreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Handle mtasa:// URLs for server connection -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mtasa" />
            </intent-filter>

        </activity>

        <!-- Test Activity - for running subsystem tests -->
        <activity
            android:name=".test.TestActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="MTA Tests"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MTA">

            <!-- Can be launched via adb for testing -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mtatest" />
            </intent-filter>

        </activity>

        <!-- GTA:SA Loader Activity - Phase 6 Integration -->
        <activity
            android:name=".GTASALoaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="MTA:SA Loader"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MTA">

            <!-- Can be launched via adb -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mtaloader" />
            </intent-filter>

        </activity>

        <!-- Network state receiver -->
        <receiver
            android:name=".NetworkReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
