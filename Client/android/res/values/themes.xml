<?xml version="1.0" encoding="utf-8"?>
<!--
  MTA:SA Android - Theme Resources
-->
<resources>
    <!-- Base application theme -->
    <style name="Theme.MTA" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryDark">#FF3700B3</item>
        <item name="colorAccent">#FF03DAC5</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>

    <!-- Fullscreen game theme -->
    <style name="Theme.MTA.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
